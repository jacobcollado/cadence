{
  "name": "cadence",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:probe": "vite build -c vite.probe.config.ts --watch",
    "build": "vite build -c vite.probe.config.ts && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:package": "vite build -c packages/cadence-probe/vite.config.ts && node -e \"require('fs').copyFileSync('LICENSE','packages/cadence-probe/LICENSE')\"",
    "release:package": "node scripts/release-package.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
